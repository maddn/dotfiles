# Fish theme using terminal palette colours.

fish_color_autosuggestion brblack
fish_color_cancel -r
fish_color_command white
fish_color_comment cyan
fish_color_cwd green
fish_color_cwd_root red
fish_color_end brmagenta
fish_color_error red --bold
fish_color_escape bryellow --bold
fish_color_history_current --bold
fish_color_host normal
fish_color_host_remote yellow
fish_color_match --background=brblue
fish_color_normal normal
fish_color_operator bryellow
fish_color_param cyan
fish_color_quote yellow
fish_color_redirection brblue
fish_color_search_match black --background=yellow
fish_color_selection white --bold --background=brblack
fish_color_status red
fish_color_user brgreen
fish_color_valid_path --underline
fish_pager_color_completion
fish_pager_color_description yellow
fish_pager_color_prefix white --bold --underline
fish_pager_color_progress black --background=cyan
fish_pager_color_selected_prefix black
fish_pager_color_selected_completion black
fish_pager_color_selected_description black
