" Airline theme.
" Generated from theme/palette.env.

scriptencoding utf-8

let s:Background =     [ 0,  '#${BACKGROUND}' ]
let s:Black =          [ 22, '#${BLACK}' ]
let s:DarkGrey =       [ 19, '#${CHROME}' ]
let s:Grey =           [ 7,  '#${FOREGROUND}' ]
let s:BrightGrey =     [ 21, '#${INACTIVE}' ]
let s:Red =            [ 1,  '#${RED}' ]
let s:Green =          [ 2,  '#${GREEN}' ]
let s:Yellow =         [ 3,  '#${YELLOW}' ]
let s:Blue =           [ 4,  '#${BLUE}' ]
let s:Magenta =        [ 5,  '#${MAGENTA}' ]
let s:Cyan =           [ 6,  '#${CYAN}' ]

function! s:ColorArray(colorfg, colorbg)
  return [ a:colorfg[1], a:colorbg[1], a:colorfg[0], a:colorbg[0], 'NONE' ]
endfunction

function! s:ColorMap(az, by, cx)
  let color_map = airline#themes#generate_color_map(a:az, a:by, a:cx, a:cx, a:by, a:az)
  let color_map.airline_warning = s:ColorArray( s:Background, s:Yellow )
  let color_map.airline_error = s:ColorArray( s:Background, s:Red )
  return color_map
endfunction

let s:N1 = s:ColorArray( s:Background, s:Yellow )
let s:N2 = s:ColorArray( s:Grey, s:DarkGrey )
let s:N3 = s:ColorArray( s:Cyan, s:Black )
let s:I1 = s:ColorArray( s:Background, s:Blue )
let s:V1 = s:ColorArray( s:Background, s:Magenta )
let s:R1 = s:ColorArray( s:Background, s:Red )
let s:C1 = s:ColorArray( s:Background, s:Green )
let s:IA = s:ColorArray( s:DarkGrey, s:Black )

let s:ModMap = {
  \ 'airline_c': s:ColorArray( s:Background, s:Red ),
  \ 'airline_warning': s:ColorArray( s:Background, s:Yellow ),
  \ 'airline_error': s:ColorArray( s:Background, s:Red ),
  \ }

let g:airline#themes#maddn#palette = {
  \ 'normal':              s:ColorMap( s:N1, s:N2, s:N3 ),
  \ 'insert':              s:ColorMap( s:I1, s:N2, s:N3 ),
  \ 'visual':              s:ColorMap( s:V1, s:N2, s:N3 ),
  \ 'replace':             s:ColorMap( s:R1, s:N2, s:N3 ),
  \ 'commandline':         s:ColorMap( s:C1, s:N2, s:N3 ),
  \ 'inactive':            airline#themes#generate_color_map( s:IA, s:IA, s:IA, s:IA, s:IA, s:IA ),
  \ 'normal_modified':     s:ModMap,
  \ 'insert_modified':     s:ModMap,
  \ 'visual_modified':     s:ModMap,
  \ 'replace_modified':    s:ModMap,
  \ 'commandline_modified': s:ModMap,
  \ 'inactive_modified':   { 'airline_c': s:ColorArray( s:DarkGrey, s:BrightGrey ) },
  \ 'tabline':             { 'airline_tab': s:ColorArray( s:Black, s:DarkGrey ) },
  \ 'accents':             { 'red': [ s:Red[1], '', s:Red[0], '', 'NONE' ] },
  \ }
