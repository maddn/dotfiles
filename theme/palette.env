# maddn master palette.
# Colours are six-digit RGB values without '#'; templates add it where needed.
# Source this file in the generation shell and export variables for envsubst.

# -- Accent Colors ------------------------------------------------------------
# Approximately 30% saturation and 60% brightness for accent colours.
# Normal and bright terminal variants share these values.

# ANSI  Name         RGB      Hue Sat Value
# ----  ----         -------  --- --- -----
# 1,9   Red          #996b6b  0   30  60
# 2,10  Green        #6B996B  120 30  60
# 3,11  Yellow       #998A6B  40  30  60
# 4,12  Blue         #6B8299  210 30  60
# 5,13  Magenta      #896A99  280 31  60
# 6,14  Cyan         #6B9991  170 30  60

RED=996b6b
GREEN=6b996b
YELLOW=998a6b
BLUE=6b8299
MAGENTA=896a99
CYAN=6b9991


# -- Greyscale ----------------------------------------------------------------
# Based on 9 percentage-point brightness increments, with exceptions below.

# ANSI  Role         RGB      Hue Sat Value
# ----  ----         -------  --- --- -----
# 22    Black        #000000  0   0   0
# 0     Background   #171717  0   0   9
# 18    Raised       #2e2e2e  0   0   18
# 19    Chrome       #454545  0   0   27
# 20    Highlight    #4f4f4f  0   0   31*
# 8     Subdued      #737373  0   0   45
# 21    Inactive     #8a8a8a  0   0   54
# 7,15  Foreground   #b8b8b8  0   0   72

# 23    Cursor Line  #202020  0   0   13

# *Highlight brightness reduced by 5 percentage points (36% to 31%).

BLACK=000000        # Primary status backgrounds.
BACKGROUND=171717   # Main terminal and editor background.
RAISED=2e2e2e       # Popups and completion menus.
CHROME=454545       # Borders, line numbers and secondary status backgrounds.
HIGHLIGHT=4f4f4f    # Selections and highlights.
SUBDUED=737373      # Folded and dim text.
INACTIVE=8a8a8a     # Modified inactive status background.
FOREGROUND=b8b8b8   # Main text, variables and parameters.

CURSOR_LINE=202020  # Current line background.


# -- Dim Accent Colours -------------------------------------------------------
# Dim background colors used for highlighting diffs.

# ANSI  Colour       RGB      Mix
# ----  ------       -------  ---
# 24    Dim Green    #2c382c  25% Green + 75% Background
# 25    Dim Red      #382c2c  25% Red + 75% Background
# 26    Dim Blue     #2c3238  25% Blue + 75% Background

DIM_GREEN=2c382c
DIM_RED=382c2c
DIM_BLUE=2c3238


# -- Supplementary Colours ----------------------------------------------------
# Supplementary colours retained for the Tinted8 export.
#
# ANSI  Colour       RGB      Hue Sat Value
# ----  ------       -------  --- --- -----
# 16    Orange       #99826b  30  30  60
# 17    Brown        #3c352f  28  22  24

ORANGE=99826b
BROWN=3c352f
